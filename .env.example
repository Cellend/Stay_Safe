# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file.

# Get a free key at https://build.nvidia.com (top-right -> Get API Key)
NVIDIA_API_KEY=

# NVIDIA NIM models (OpenAI-compatible). Confirmed actually invokable AND
# reliable against a real account on 2026-09-05 (many listed catalog models
# 404 with "Function ... Not found for account" - being listed by
# client.models.list() does NOT mean a given key can call it. Also,
# mistralai/mistral-nemotron was tried first as the generator per a
# "Mistral generator + Nemotron judge" design goal, but its backend
# returned real 500 errors in live testing - see rag/llm_client.py).
# Catalogs and their reliability change - re-verify periodically.
GENERATOR_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Seconds to pause between sequential calls in the batch eval scripts
# (generate_ground_truth.py, llm_judge.py) - free-tier accounts are
# rate-limited. Raise this if you see rate-limit errors in their output.
NVIDIA_REQUEST_DELAY_SECONDS=1.0

# Elasticsearch (local Docker, security disabled for this demo)
ELASTICSEARCH_URL=http://localhost:9200
ES_INDEX_NAME=ready_chunks

# Which backend to actually use. Local dev: leave both as-is (Elasticsearch
# + SQLite, what's been built and tested throughout this project). For a
# deployed copy with nowhere free to run Elasticsearch or persist SQLite
# (e.g. Streamlit Community Cloud), switch either or both to "supabase" -
# see README.md's deployment section for the one-time Supabase setup.
RETRIEVAL_BACKEND=elasticsearch
METRICS_BACKEND=sqlite

# Only needed if either backend above is "supabase". From your Supabase
# project: Settings -> Database -> Connection string (URI format).
SUPABASE_DB_URL=

# Local file paths (defaults match the existing project layout)
SQLITE_DB_PATH=ready_raw.db
METRICS_DB_PATH=metrics.db
EMBED_MODEL=all-MiniLM-L6-v2

# Set to 1 only after the embed model has downloaded successfully once -
# skips a slow update-check network call on every process start. Leave
# blank on first run.
HF_HUB_OFFLINE=
